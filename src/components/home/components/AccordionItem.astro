---
interface Props {
    question: string;
    answer: string;
    isOpen?: boolean;
}

const { question, answer, isOpen = false } = Astro.props;
---

<details class="group bg-white border border-border-light rounded-lg mb-4 overflow-hidden" open={isOpen}>
    <summary class="flex justify-between items-center p-6 cursor-pointer select-none list-none [&::-webkit-details-marker]:hidden">
        <span class="font-semibold text-[1.1rem] text-text-main">{question}</span>
        <span class="text-dolex-red transition-transform duration-300 ease-out flex items-center group-open:rotate-180">
            <svg
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
            >
                <path
                    d="M7 10L12 15L17 10"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </span>
    </summary>
    <div class="px-6 pb-6 text-gray-500 leading-relaxed">
        <p class="m-0">{answer}</p>
    </div>
</details>
