---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";
import placesData from "../../../data/places/places.data.json";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const data = homeContent[lang].places;
---

<section class="bg-bg-light px-5 md:px-[8%] py-20" id="places-section">
    <div
        class="max-w-[1200px] mx-auto bg-white rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.05)] flex flex-col md:flex-row overflow-hidden"
    >
        <div class="flex-1 p-8 md:p-16 flex flex-col justify-center">
            <h2 class="text-[2rem] font-extrabold text-dolex-red mb-4">
                {data.title}
            </h2>
            <p class="text-lg text-gray-500 mb-10 leading-relaxed">
                {data.description}
            </p>

            <form
                id="places-search-form"
                class="flex flex-col sm:flex-row gap-4 mb-8"
            >
                <input
                    type="text"
                    id="zipcode-input"
                    placeholder={data.placeholder}
                    required
                    pattern="[0-9]*"
                    title="Please enter a valid zip code"
                    class="flex-1 px-6 py-4 border border-border-light rounded-lg text-base bg-gray-50 outline-none transition-all duration-200 focus:border-dolex-red focus:shadow-[0_0_0_3px_rgba(209,0,41,0.1)] focus:bg-white"
                />
                <button
                    type="submit"
                    class="bg-dolex-red text-white px-8 py-4 border-none rounded-lg font-bold cursor-pointer transition-colors duration-200 hover:bg-dolex-red-hover"
                    >{data.button}</button
                >
            </form>

            <div
                id="places-results"
                class="flex flex-col gap-4"
                style="display: none;"
            >
                <!-- Results will appear here -->
            </div>
        </div>

        <div class="flex-1 bg-[#e5e5e5] min-h-[400px] relative">
            <iframe
                id="google-map-iframe"
                width="100%"
                height="100%"
                style="border:0;"
                allowfullscreen={true}
                loading="lazy"
                referrerpolicy="no-referrer-when-downgrade"
                src=""
                class="hidden absolute inset-0"></iframe>
            <div
                id="map-placeholder"
                class="w-full h-full flex items-center justify-center absolute inset-0"
            >
                <div
                    class="flex flex-col items-center gap-2 text-gray-500 font-semibold"
                >
                    <svg
                        width="48"
                        height="48"
                        viewBox="0 0 24 24"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z"
                            fill="#d10029"
                            fill-opacity="0.5"></path>
                    </svg>
                    <span>Mapa interactivo</span>
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { actions } from "astro:actions";

    // Declaración global para evitar errores de TypeScript con Umami
    declare global {
        interface Window {
            umami?: {
                track: (
                    eventName: string,
                    eventData?: Record<string, any>,
                ) => void;
            };
        }
    }

    document.addEventListener("astro:page-load", () => {
        const form = document.getElementById(
            "places-search-form",
        ) as HTMLFormElement | null;
        const input = document.getElementById(
            "zipcode-input",
        ) as HTMLInputElement | null;
        const results = document.getElementById(
            "places-results",
        ) as HTMLDivElement | null;

        const handleHashChange = () => {
            const hash = window.location.hash;
            if (hash.startsWith("#places?zipcode=")) {
                const zipcode = hash.replace("#places?zipcode=", "");
                if (input) {
                    input.value = zipcode;
                }
                performMapSearch(zipcode);
            }
        };

        const performMapSearch = async (zipcode: string) => {
            if (!results) return;

            try {
                const response = await actions.getPlacesByZipcode({ zipcode });
                const matchedPlaces = response.data?.data || [];

                results.style.display = "flex";

                if (matchedPlaces.length > 0) {
                    results.innerHTML = matchedPlaces
                        .map(
                            (place) => `
                        <div class="flex gap-4 p-4 border border-border-light rounded-xl bg-white transition-all duration-200 hover:border-dolex-red">
                            <div class="text-dolex-red shrink-0 pt-1">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                    <path d="M12 2C8.13 2 5 5.13 5 9C5 14.25 12 22 12 22C12 22 19 14.25 19 9C19 5.13 15.87 2 12 2ZM12 11.5C10.62 11.5 9.5 10.38 9.5 9C9.5 7.62 10.62 6.5 12 6.5C13.38 6.5 14.5 7.62 14.5 9C14.5 10.38 13.38 11.5 12 11.5Z" fill="currentColor"/>
                                </svg>
                            </div>
                            <div>
                                <h4 class="m-0 mb-1 font-bold text-text-main">${place.name}</h4>
                                <a  
                                    data-umami-event="Click store locator"
                                    data-umami-event-zipcode="${zipcode}"
                                    data-umami-event-store-name="${place.name}"
                                    href="https://www.google.com/maps?q=${encodeURIComponent(place.address)}" target="_blank" rel="noopener noreferrer" class="m-0 mb-2 text-sm text-gray-500 hover:text-dolex-red hover:underline block no-underline transition-colors">${place.address}</a>
                                <span class="text-[0.8rem] font-bold text-[#059669] flex items-center gap-1 before:content-[''] before:inline-block before:w-1.5 before:h-1.5 before:bg-[#059669] before:rounded-full">Abierto ahora</span>
                            </div>
                        </div>
                    `,
                        )
                        .join("");

                    const mapQuery = matchedPlaces[0].address;
                    const mapEmbedSrc = `https://www.google.com/maps?q=${encodeURIComponent(mapQuery)}&output=embed`;

                    const iframe = document.getElementById(
                        "google-map-iframe",
                    ) as HTMLIFrameElement | null;
                    const placeholder = document.getElementById(
                        "map-placeholder",
                    ) as HTMLDivElement | null;
                    if (iframe && placeholder) {
                        iframe.src = mapEmbedSrc;
                        iframe.classList.remove("hidden");
                        placeholder.classList.add("hidden");
                    }
                } else {
                    results.innerHTML = `
                        <div class="p-6 text-center text-gray-500 bg-white border border-border-light rounded-xl">
                            No stores found for zipcode ${zipcode}. Try 77500 or 77710.
                        </div>
                    `;
                    const iframe = document.getElementById(
                        "google-map-iframe",
                    ) as HTMLIFrameElement | null;
                    const placeholder = document.getElementById(
                        "map-placeholder",
                    ) as HTMLDivElement | null;
                    if (iframe && placeholder) {
                        iframe.classList.add("hidden");
                        placeholder.classList.remove("hidden");
                    }
                }
            } catch (error) {
                console.error("Error fetching places:", error);
                results.innerHTML = `
                    <div class="p-6 text-center text-dolex-red bg-white border border-dolex-red rounded-xl">
                        An error occurred while fetching stores. Please try again.
                    </div>
                `;
            }
        };

        if (form) {
            form.addEventListener("submit", (e) => {
                e.preventDefault();
                if (input) {
                    const zipcode = input.value.trim();
                    if (zipcode) {
                        // 1. Usar umami.track() pasando la función directa o esperando si existe
                        if (typeof window.umami !== "undefined") {
                            window.umami.track("Click find at Store", {
                                zipcode,
                            });
                        } else if (
                            typeof (window as any).umami?.track === "function"
                        ) {
                            (window as any).umami.track("Click find at Store", {
                                zipcode,
                            });
                        } else {
                            console.warn(
                                "Umami no está cargado aún o está bloqueado por un adblocker.",
                            );
                        }

                        // 2. Tu lógica para actualizar la UI y la URL
                        window.history.pushState(
                            null,
                            "",
                            `#places?zipcode=${zipcode}`,
                        );
                        performMapSearch(zipcode);
                    }
                }
            });
        }

        if ((window as any)._placesHashListener) {
            window.removeEventListener(
                "hashchange",
                (window as any)._placesHashListener,
            );
        }
        (window as any)._placesHashListener = handleHashChange;
        window.addEventListener("hashchange", handleHashChange);

        handleHashChange();
    });
</script>
