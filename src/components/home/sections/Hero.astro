---
import type { Lang } from "../../../i18n/config.i18n";
import homeContent from "../../../data/site-home-content.json";

interface Props {
    lang: Lang;
}

const { lang } = Astro.props;
const data = homeContent[lang].hero;

const images = [
    "/images/dolex-forte/products/37-0076.png",
    "/images/hero/home/hero_1.home.png",
    "/images/hero/home/hero_2.home.png",
    "/images/dolex-children/products/37-0115.png",
];
---

<section
    class="flex flex-col md:flex-row items-center justify-between px-5 md:px-[8%] py-12 md:py-16 bg-bg-light min-h-[80vh] overflow-hidden relative text-center md:text-left"
>
    <div class="hero-content relative z-10 w-full md:max-w-[50%] mb-12 md:mb-0">
        <span
            class="inline-flex items-center gap-2 bg-[#ffe6eb] text-dolex-red font-bold text-xs px-3 py-1 rounded-full mb-6 tracking-wider"
        >
            <svg
                width="12"
                height="12"
                viewBox="0 0 24 24"
                fill="none"
                xmlns="http://www.w3.org/2000/svg"
                ><path
                    d="M13 2L3 14H12L11 22L21 10H12L13 2Z"
                    fill="currentColor"></path></svg
            >
            {data.subtitle}
        </span>
        <h1
            class="text-5xl md:text-6xl font-extrabold leading-tight text-text-main mb-6"
        >
            {data.title.split(",")[0]},<br />
            <span class="text-dolex-red">{data.title.split(",")[1]}</span>
        </h1>
        <p
            class="text-lg text-text-muted leading-relaxed mb-10 md:max-w-[85%] mx-auto md:mx-0"
        >
            {data.description}
        </p>
        <div class="flex justify-center md:justify-start gap-4">
            <a
                href={`/${lang}/dolex-forte`}
                class="bg-dolex-red text-white px-8 py-3 rounded-lg font-semibold no-underline transition-colors duration-200 hover:bg-dolex-red-hover"
            >
                {data.cta1}
            </a>
            <button
                class="bg-transparent text-dolex-red border-2 border-dolex-red px-8 py-3 rounded-lg font-semibold cursor-pointer transition-colors duration-200 hover:bg-[#fff0f3]"
            >
                {data.cta2}
            </button>
        </div>
    </div>

    <div
        class="relative w-full md:w-[45%] h-[350px] md:h-[500px] flex items-center justify-center"
    >
        <div class="relative w-full h-full" id="hero-slider">
            {
                images.map((src, index) => (
                    <div
                        class={`slide absolute top-0 left-0 w-full h-full flex items-center justify-center transition-opacity duration-1000 ease-in-out ${index === 0 ? "opacity-100" : "opacity-0"}`}
                    >
                        <img
                            src={src}
                            alt="Dolex Forte Hero"
                            class="max-w-full max-h-full object-contain drop-shadow-[0_20px_30px_rgba(0,0,0,0.15)]"
                        />
                    </div>
                ))
            }
        </div>
    </div>
</section>

<script>
    document.addEventListener("DOMContentLoaded", () => {
        const slides = document.querySelectorAll("#hero-slider .slide");
        let currentSlide = 0;

        if (slides.length > 1) {
            setInterval(() => {
                slides[currentSlide].classList.remove("opacity-100");
                slides[currentSlide].classList.add("opacity-0");
                currentSlide = (currentSlide + 1) % slides.length;
                slides[currentSlide].classList.remove("opacity-0");
                slides[currentSlide].classList.add("opacity-100");
            }, 3000);
        }
    });
</script>
