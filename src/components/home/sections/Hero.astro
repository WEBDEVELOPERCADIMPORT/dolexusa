---
import type { Lang } from "../../../i18n/config.i18n";
import type { Category } from "../../../actions/categories/getCategories.action";
import homeContent from "../../../data/site-home-content.json";

interface Props {
    lang: Lang;
    categories: Category[];
}

const { lang, categories } = Astro.props;
const data = homeContent[lang].hero;
const symptoms = homeContent[lang].symptoms.items;

const getCategoryDescription = (catName: string) => {
    const found = symptoms.find((s) => s.product === catName);
    return found ? found.title : "";
};
---

<section class="relative w-full h-[60vh] md:h-[60vh] overflow-hidden bg-black">
    <div class="absolute inset-0 w-full h-full" id="hero-slider">
        {
            categories.map((cat, index) => (
                <div
                    class={`slide absolute inset-0 w-full h-full transition-opacity duration-1000 ease-in-out bg-cover bg-center flex flex-col justify-center ${index === 0 ? "opacity-100 z-10 active-slide" : "opacity-0 z-0"}`}
                    style={`background-image: url('${cat.banner}')`}
                >
                    <div class="absolute inset-0 bg-gradient-to-r from-black/30 via-black/30 to-transparent" />

                    <div class="slide-content relative z-20 w-full px-5 md:px-[8%] flex flex-col items-center md:items-end text-center md:text-right mt-10 md:mt-0">
                        <h2
                            class="text-5xl md:text-7xl font-black uppercase mb-2 tracking-tight"
                            style="color: #ffe600; -webkit-text-stroke: 1px #d10029; text-shadow: 3px 3px 0 #cc5a00, 4px 4px 5px rgba(0,0,0,0.5);"
                        >
                            {cat.name}
                        </h2>

                        <p class="text-white text-xl md:text-2xl md:text-right font-bold mb-8 drop-shadow-md max-w-md">
                            {getCategoryDescription(cat.name)}
                        </p>

                        <div class="flex flex-col sm:flex-row gap-4 items-center md:items-end w-full sm:w-auto">
                            <a
                                href={`/${lang}/${cat.slug}`}
                                class="bg-dolex-red text-white px-8 py-3 rounded-xl font-bold text-[1.1rem] no-underline hover:bg-red-700 transition-colors w-full sm:w-auto text-center shadow-lg"
                            >
                                {data.btnViewMore}
                            </a>
                            <a
                                href={`/${lang}#places-section`}
                                class="bg-white text-dolex-red px-8 py-3 rounded-xl font-bold text-[1.1rem] no-underline hover:bg-gray-100 transition-colors w-full sm:w-auto text-center shadow-lg"
                            >
                                {data.btnFindStore}
                            </a>
                        </div>
                    </div>
                </div>
            ))
        }
    </div>
</section>

<style>
    @keyframes slideUpFadeIn {
        0% {
            opacity: 0;
            transform: translateY(30px);
        }
        100% {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* Base state (invisible) */
    .slide-content h2,
    .slide-content p,
    .slide-content div {
        opacity: 0;
    }

    /* Active state (triggers animation) */
    .active-slide .slide-content h2 {
        animation: slideUpFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: 0.1s;
    }

    .active-slide .slide-content p {
        animation: slideUpFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: 0.3s;
    }

    .active-slide .slide-content div {
        animation: slideUpFadeIn 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
        animation-delay: 0.5s;
    }
</style>

<script>
    document.addEventListener("astro:page-load", () => {
        const slides = document.querySelectorAll("#hero-slider .slide");
        let currentSlide = 0;

        if (slides.length > 1) {
            if ((window as any).heroSliderInterval) {
                clearInterval((window as any).heroSliderInterval);
            }

            (window as any).heroSliderInterval = setInterval(() => {
                slides[currentSlide].classList.remove(
                    "opacity-100",
                    "z-10",
                    "active-slide",
                );
                slides[currentSlide].classList.add("opacity-0", "z-0");

                currentSlide = (currentSlide + 1) % slides.length;

                slides[currentSlide].classList.remove("opacity-0", "z-0");
                slides[currentSlide].classList.add(
                    "opacity-100",
                    "z-10",
                    "active-slide",
                );
            }, 5000); // Increased interval to 5 seconds to allow animations to play fully
        }
    });
</script>
