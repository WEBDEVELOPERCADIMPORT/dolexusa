---
import type { Product } from "../../../actions/products/getProductsByCategory.action";
import type { Category } from "../../../actions/categories/getCategories.action";
import productContent from "../../../data/site-product-content.json";
import type { Lang } from "../../../i18n/config.i18n";
import BuyStoreButton from "../../utils/BuyStoreButton.astro";

interface Props {
    product: Product;
    category: Category;
    lang: Lang;
}

const { product, category, lang } = Astro.props;
const data = productContent[lang].productDetail;
---

<section class="bg-bg-light px-5 md:px-[8%] py-16">
    <div
        class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-start gap-12 md:gap-20 relative"
    >
        <div
            class="flex-1 w-full bg-white p-8 md:p-16 rounded-3xl shadow-[0_10px_40px_rgba(0,0,0,0.05)] flex justify-center items-center md:sticky md:top-32"
        >
            <img
                src={product.image}
                alt={product.name}
                class="max-w-full max-h-150 object-contain drop-shadow-[0_20px_30px_rgba(0,0,0,0.1)]"
            />
        </div>

        <div class="flex-1 w-full md:max-w-[550px]">
            <span
                class="inline-block px-4 py-2 rounded-full font-bold text-[0.85rem] uppercase tracking-[0.1em] mb-6"
                style={`background-color: ${category.color}20; color: ${category.color}`}
            >
                {category.name}
            </span>

            <h1
                class="text-5xl md:text-[3rem] font-extrabold leading-tight mb-6"
                style={`color: ${category.color}`}
            >
                {product.name}
            </h1>

            <span class="text-gray-500 mb-4 block">SKU: {product.sku}</span>

            <div class="mb-10">
                <p
                    id="product-desc"
                    class="text-[1.125rem] text-text-muted leading-relaxed line-clamp-3 transition-all duration-300 whitespace-pre-line"
                >
                    {product.description}
                </p>
                <button
                    id="toggle-desc-btn"
                    class="text-dolex-red font-semibold mt-2 hover:underline cursor-pointer bg-transparent border-none p-0 text-[1rem] hidden"
                    data-read-more={data.readMore}
                    data-read-less={data.readLess}
                >
                    {data.readMore}
                </button>
            </div>

            <div class="flex flex-col gap-4 mb-12">
                {
                    product.details.map((detail) => (
                        <div class="flex items-center gap-4 text-[1.05rem] font-medium text-text-main">
                            <span
                                class="bg-black/5 p-2 rounded-full flex items-center justify-center shrink-0"
                                style={`color: ${category.color}`}
                            >
                                <svg
                                    width="20"
                                    height="20"
                                    viewBox="0 0 24 24"
                                    fill="none"
                                    xmlns="http://www.w3.org/2000/svg"
                                >
                                    <path
                                        d="M9 16.2L4.8 12L3.4 13.4L9 19L21 7L19.6 5.6L9 16.2Z"
                                        fill="currentColor"
                                    />
                                </svg>
                            </span>
                            <span>{detail}</span>
                        </div>
                    ))
                }
            </div>

            <div class="flex">
                <BuyStoreButton
                    href={product.linkVasAlSuper}
                    text={data.buyButton}
                    style={`background-color: ${category.color}`}
                    class="!inline-flex px-10 py-5 rounded-xl text-[1.1rem] shadow-[0_10px_20px_rgba(0,0,0,0.1)] w-full md:max-w-[400px] hover:-translate-y-[2px]"
                    product={product}
                />
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener("astro:page-load", () => {
        const desc = document.getElementById("product-desc");
        const btn = document.getElementById("toggle-desc-btn");

        if (desc && btn) {
            // Check if text is clamped
            if (
                desc.scrollHeight > desc.clientHeight ||
                desc.classList.contains("line-clamp-none")
            ) {
                btn.classList.remove("hidden");

                btn.addEventListener("click", () => {
                    const isExpanded =
                        desc.classList.contains("line-clamp-none");
                    if (isExpanded) {
                        desc.classList.remove("line-clamp-none");
                        desc.classList.add("line-clamp-3");
                        btn.textContent = btn.dataset.readMore || "Leer más";
                    } else {
                        desc.classList.remove("line-clamp-3");
                        desc.classList.add("line-clamp-none");
                        btn.textContent = btn.dataset.readLess || "Leer menos";
                    }
                });
            }
        }
    });
</script>
