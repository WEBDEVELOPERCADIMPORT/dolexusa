---
import { FadeInText, ScaleIn } from "@astroanimate/core";

import type { Category } from "../../../actions/categories/getCategories.action";
import categoryContent from "../../../data/site-category-content.json";
import homeContent from "../../../data/site-home-content.json";
import type { Lang } from "../../../i18n/config.i18n";

interface Props {
    category: Category;
    lang: Lang;
}

const { category, lang } = Astro.props;
const data = categoryContent[lang].hero;

const symptoms = homeContent[lang].symptoms.items;
const symptomMatch = symptoms.find(s => s.product === category.name);
const description = symptomMatch ? symptomMatch.heroDescription : `Descubre el alivio que necesitas con la línea especializada de ${category.name}. Diseñado para actuar donde más lo necesitas.`;
---

<section
    class="bg-[var(--cat-color,#d10029)] text-white px-5 md:px-[8%] py-16 mt-4 relative overflow-hidden"
    style={`--cat-color: ${category.color}`}
>
    <div
        class="max-w-[1200px] mx-auto flex flex-col md:flex-row items-center justify-between gap-16 relative z-10 text-center md:text-left"
    >
        <div class="flex-1 w-full md:max-w-[50%]">
            <FadeInText
                as="span"
                enhance={false}
                delay={0}
                class="inline-block bg-white/20 text-white font-bold text-[0.85rem] px-4 py-1.5 rounded-full mb-6 uppercase tracking-wider"
                >{data.subtitle}</FadeInText
            >
            <FadeInText
                as="h1"
                enhance={false}
                delay={0.15}
                class="text-5xl md:text-6xl font-extrabold leading-tight mb-6"
                >{category.name}</FadeInText
            >
            <!-- If there was a description field in category, it would go here -->
            <FadeInText
                as="p"
                enhance={false}
                delay={0.25}
                class="text-lg leading-relaxed opacity-90"
                >{description}</FadeInText
            >
        </div>

        <ScaleIn
            as="div"
            enhance={false}
            initialScale={0.95}
            duration={600}
            delay={100}
            class="flex-1 flex justify-center md:justify-end w-full"
        >
            <img
                src={category.banner}
                alt={`${category.name} Banner`}
                class="max-w-full h-auto max-h-[400px] object-contain drop-shadow-[0_20px_30px_rgba(0,0,0,0.2)]"
            />
        </ScaleIn>
    </div>
</section>
