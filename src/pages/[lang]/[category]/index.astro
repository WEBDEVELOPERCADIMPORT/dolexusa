---
import Layout from "../../../layouts/Layout.astro";
import type { Lang } from "../../../i18n/config.i18n";
import { actions } from "astro:actions";
import { ui } from "../../../i18n/ui.i18n";
import homeContent from "../../../data/site-home-content.json";

import Breadcrumb from "../../../components/product/sections/Breadcrumb.astro";
import HeroCategory from "../../../components/category/sections/HeroCategory.astro";
import ProductList from "../../../components/category/sections/ProductList.astro";
import SingleProduct from "../../../components/category/sections/SingleProduct.astro";
import FAQ from "../../../components/home/sections/FAQ.astro";

const lang = Astro.params.lang as Lang;
const categorySlug = Astro.params.category as string;

// Fetch Data
const { data: categoryResponse } = await Astro.callAction(
    actions.getCategoryBySlug,
    { slug: categorySlug, lang },
);
const category = categoryResponse?.data;

if (!category) {
    return Astro.redirect("/404");
}

const { data: productsResponse } = await Astro.callAction(
    actions.getProductsByCategory,
    { categorySlug, lang },
);
const products = productsResponse?.data || [];

const symptoms = homeContent[lang].symptoms.items;
const symptomMatch = symptoms.find(s => s.product === category.name);
const categoryDescription = symptomMatch ? symptomMatch.heroDescription : "";
---

<Layout
    title={`${category.name} | ${ui[lang].layout.catalogTitle}`}
    lang={lang}
    description={categoryDescription}
    image={category.banner}
>
    <main>
        <Breadcrumb category={category} lang={lang} />
        <HeroCategory category={category} lang={lang} />

        {
            products.length >= 2 ? (
                <ProductList
                    products={products}
                    category={category}
                    lang={lang}
                />
            ) : products.length === 1 ? (
                <SingleProduct
                    product={products[0]}
                    category={category}
                    lang={lang}
                />
            ) : (
                <div style="text-align: center; padding: 4rem;">
                    <p>No hay productos disponibles en esta categoría.</p>
                </div>
            )
        }

        <FAQ lang={lang} />
    </main>
</Layout>
