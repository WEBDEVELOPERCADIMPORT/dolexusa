---
import Layout from "../../layouts/Layout.astro";
import content from "../../data/site-content.json";
import homeContent from "../../data/site-home-content.json";
import type { Lang } from "../../i18n/config.i18n";
import { actions } from "astro:actions";

import Hero from "../../components/home/sections/Hero.astro";
import About from "../../components/home/sections/About.astro";
import Categories from "../../components/home/sections/Categories.astro";
import Symptoms from "../../components/home/sections/Symptoms.astro";
import FAQ from "../../components/home/sections/FAQ.astro";
import Places from "../../components/home/sections/Places.astro";

const lang = Astro.params.lang as Lang;

if (!(lang in content)) {
    return Astro.redirect("/404");
}

const globalData = content[lang];
const data = homeContent[lang];
const { data: categoriesResult } = await Astro.callAction(
    actions.getCategories,
    {},
);
const categories = categoriesResult?.data || [];
---

<Layout
    title={`Dolex - ${data.hero.title}`}
    lang={lang}
    description={data.hero.description}
    image="/images/hero/home/hero_1.home.png"
>
    <main>
        <Hero lang={lang} categories={categories} />
        <Categories lang={lang} categories={categories} />

        <About lang={lang} />
        <Symptoms lang={lang} />
        <Places lang={lang} />
        <FAQ lang={lang} />
    </main>
</Layout>
